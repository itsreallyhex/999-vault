{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "999 Vault",
  "version": "0.1.0",
  "identifier": "xyz.juicevault.nine",
  "build": {
    "frontendDist": "nine://localhost"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src": "pages",
      "../../web/data/catalogue.json": "seed/catalogue.json"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDRjJCMTQzQjNGNENCQTcKUldTbnkvU3pRN0h5VEdKdjE4RTV3S2EwNkxNUC9vY3BEZUE5cEpmQ0x5S3lpK2NZaU53eU9YZ2cK",
      "endpoints": [
        "https://github.com/itsreallyhex/999-vault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
