/web/.env
# Any variant too: a .env.bak or .env.local holding a bearer token must not
# become the one file that leaks it.
/web/.env.*
/CLAUDE.md

# Saved cover images. Thousands of binaries that git would carry forever,
# and `python tools/save-catalogue.py --covers`, run from web/, rebuilds
# them. The catalogue itself stays tracked: it is the thing that makes the
# pages work offline.
/web/data/covers/
# Maps record id to cover hash. Describes the folder above, so it is useless
# without it, and `--dedupe` rebuilds it from whatever is on disk.
/web/data/covers-index.json

# Audio. Tens of gigabytes of somebody else's recordings, fetched by
# web/tools/save-audio.py. This must never end up in a commit.
/web/data/audio/
/web/data/audio-index.json
*.mp3
*.wav
*.m4a
*.flac

# graphify's knowledge graph of this repo, written by /graphify. Derived
# data, not source: it holds a second full copy of the extraction plus a
# 360 KB graph.html, and `/graphify . --update` rebuilds it from the files
# tracked here anyway. The cache/ and manifest.json inside it are what make
# a re-run cheap, and they are machine-local by nature.
/graphify-out/

__pycache__/
*.pyc

# The desktop app's build output and dependencies. target/ alone runs to
# several GB of compiled crates, node_modules holds the Tauri CLI, and
# gen/ is schema output the build writes for itself. All three are
# rebuilt by `npm install` and `cargo build`.
/desktop/node_modules/
/desktop/src-tauri/target/
/desktop/src-tauri/gen/
